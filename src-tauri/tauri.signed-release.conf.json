{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../licenses/": "licenses/",
      "../LICENSE": "licenses/BITIG-MIT.txt",
      "../THIRD-PARTY-SOURCES.md": "licenses/THIRD-PARTY-SOURCES.md"
    },
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/sign-windows.ps1",
          "-FilePath",
          "%1"
        ]
      }
    }
  }
}
