{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BITIG",
  "version": "0.1.1",
  "identifier": "app.bitig.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BITIG",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data: https:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/media/**/*", "$APPLOCALDATA/thumbnails/**/*"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "externalBin": []
  }
}
